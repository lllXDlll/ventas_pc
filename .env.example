# Variables fuera del Worker (CLI de Prisma, frontend, scripts). Copia a .env (ignorado por Git).
# Las variables del Worker de la API están en apps/api/.dev.vars.example.

# Cadena DIRECTA de Neon (sin "-pooler"), solo para migraciones: `pnpm --filter api migrate:deploy`.
# Si no se define, Prisma usa el Postgres local de docker-compose.
# En CI es el secreto NEON_DIRECT_URL. El Worker NO la usa: se conecta por Hyperdrive.
DIRECT_URL=

# URL pública de la API para el frontend (se fija al compilar).
# Local: http://localhost:8787 · Producción: https://api.xdtech.store
NEXT_PUBLIC_API_URL=http://localhost:8787

# Token del endpoint TEMPORAL /__prototipo/inventario (script tests/prototipos/reservas-300.ts).
PROTOTIPO_TOKEN=
