{
  "name": "ventas-pc",
  "private": true,
  "type": "module",
  "description": "Plataforma de venta de computadoras y componentes (xdtech.store)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint . && node scripts/sin-colores-sueltos.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
