// Worker del frontend (Next.js con OpenNext). Versionado y SIN secretos.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xdtech-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Custom Domains (tarea 6.5, P3). www redirige al apex (next.config.ts).
  // workers.dev queda activo para diagnóstico (tarea 5.2).
  "workers_dev": true,
  "routes": [
    { "pattern": "xdtech.store", "custom_domain": true },
    { "pattern": "www.xdtech.store", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
  },
}
