# Variables locales para `wrangler dev`. Copia este archivo a .dev.vars (ignorado por Git).
# Sobrescriben los "vars" de producción definidos en wrangler.jsonc.

# Sesión y CORS: en local, la cookie va sin Domain ni Secure.
COOKIE_DOMAIN=
FRONTEND_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=7

# Tiempo de espera de cada dependencia en GET /health/ready (ms).
HEALTH_TIMEOUT_MS=3000

# Límites de peticiones: intentos máximos y ventana en minutos (registro por IP;
# inicio de sesión: fallos por correo e intentos por IP).
LIMITE_REGISTRO_MAX=5
LIMITE_REGISTRO_VENTANA_MIN=60
LIMITE_LOGIN_CORREO_MAX=5
LIMITE_LOGIN_IP_MAX=50
LIMITE_LOGIN_VENTANA_MIN=15

# Asistente de IA (Sprint 5). En local se usa el proveedor simulado: sin red ni costo.
# Para probar contra AI Gateway: IA_PROVEEDOR=anthropic e IA_GATEWAY_URL / CF_AIG_TOKEN
# (secretos: nunca los subas al repositorio).
IA_HABILITADA=true
IA_PROVEEDOR=simulado
IA_TIMEOUT_MS=20000
ASISTENTE_LIMITE_24H=10
