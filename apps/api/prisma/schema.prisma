// Modelo de datos inicial (parte técnica, sección 4; spec esquema-datos; design.md D11).
// Restricciones que Prisma no expresa (CHECK, citext) se agregan en el SQL de la migración.
// Sin tabla tokens_recuperacion: HU-03 está diferida.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "workerd"
  moduleFormat        = "esm"
  // Sin extensión en los imports: tsc compila a dist/ sin reescribirlos y Wrangler los
  // empaqueta. Fijo, para que no dependa de allowImportingTsExtensions del tsconfig.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enumerados ─────────────

enum Rol {
  CLIENTE
  ADMIN

  @@map("rol")
}

enum EstadoUsuario {
  ACTIVO
  BLOQUEADO

  @@map("estado_usuario")
}

enum TipoProducto {
  COMPONENTE
  EQUIPO

  @@map("tipo_producto")
}

enum CodigoRegla {
  SOCKET
  RAM
  POTENCIA
  DIMENSIONES
  FACTOR_FORMA
  ALMACENAMIENTO

  @@map("codigo_regla")
}

enum OrigenConfiguracion {
  MANUAL
  IA

  @@map("origen_configuracion")
}

enum EstadoConfiguracion {
  BORRADOR
  VALIDA
  INVALIDA

  @@map("estado_configuracion")
}

enum EstadoReserva {
  ACTIVA
  CONFIRMADA
  EXPIRADA

  @@map("estado_reserva")
}

// ───────────── Usuarios y sesiones ─────────────

model Usuario {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// Único sin distinguir mayúsculas (tipo citext).
  correo         String        @unique @db.Citext
  hashContrasena String        @map("hash_contrasena")
  rol            Rol           @default(CLIENTE)
  estado         EstadoUsuario @default(ACTIVO)
  creadoEn       DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime      @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  sesiones        Sesion[]
  configuraciones Configuracion[]
  carrito         Carrito?
  reservas        Reserva[]
  ordenes         Orden[]
  notificaciones  Notificacion[]
  usosAsistente   UsoAsistente[]

  @@map("usuarios")
}

model Sesion {
  id         String    @id @default(uuid(7)) @db.Uuid
  /// Hash del token; el token en claro solo vive en la cookie.
  tokenHash  String    @unique @map("token_hash")
  usuarioId  String    @map("usuario_id") @db.Uuid
  venceEn    DateTime  @map("vence_en") @db.Timestamptz(3)
  revocada   Boolean   @default(false)
  /// Momento de la revocación; nulo mientras la sesión no esté revocada. La limpieza
  /// diaria borra las revocadas hace más de un día (Sprint 1, design D4).
  revocadaEn DateTime? @map("revocada_en") @db.Timestamptz(3)
  creadaEn   DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([venceEn])
  @@map("sesiones")
}

// ───────────── Catálogo ─────────────

model Categoria {
  id        String     @id @default(uuid(7)) @db.Uuid
  /// PROCESADOR, PLACA_MADRE, RAM, TARJETA_GRAFICA, FUENTE, GABINETE, ALMACENAMIENTO, EQUIPO_ARMADO
  codigo    String     @unique
  nombre    String
  productos Producto[]

  @@map("categorias")
}

model Producto {
  id            String       @id @default(uuid(7)) @db.Uuid
  nombre        String
  /// Obligatoria al crear desde la API; nula solo en filas previas al Sprint 1.5.
  marca         String?
  categoriaId   String       @map("categoria_id") @db.Uuid
  tipo          TipoProducto
  /// CHECK precio >= 0 (migración).
  precio        Decimal      @db.Decimal(12, 2)
  activo        Boolean      @default(true)
  /// Atributos técnicos: socket, tipoRam, potenciaConsumidaW, dimensiones, factorForma, etc.
  atributos     Json         @default("{}") @db.JsonB
  /// Clave del objeto en R2 (productos/<id>/<uuid>.<ext>); nula si no tiene imagen.
  imagenClave   String?      @map("imagen_clave")
  creadoEn      DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime     @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  categoria          Categoria           @relation(fields: [categoriaId], references: [id])
  stock              Stock?
  configuracionItems ConfiguracionItem[]
  carritoItems       CarritoItem[]
  reservaItems       ReservaItem[]
  ordenItems         OrdenItem[]

  @@index([categoriaId, activo])
  @@map("productos")
}

model Stock {
  id         String @id @default(uuid(7)) @db.Uuid
  productoId String @unique @map("producto_id") @db.Uuid
  /// Stock físico. CHECK cantidad >= 0 (migración).
  cantidad   Int
  /// Bloqueo optimista.
  version    Int    @default(0)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@map("stock")
}

model ReglaCompatibilidad {
  id         String      @id @default(uuid(7)) @db.Uuid
  codigo     CodigoRegla @unique
  parametros Json        @default("{}") @db.JsonB
  activa     Boolean     @default(true)

  @@map("reglas_compatibilidad")
}

// ───────────── Configuraciones y carrito ─────────────

model Configuracion {
  id          String              @id @default(uuid(7)) @db.Uuid
  usuarioId   String              @map("usuario_id") @db.Uuid
  origen      OrigenConfiguracion
  presupuesto Decimal?            @db.Decimal(12, 2)
  uso         String?
  estado      EstadoConfiguracion @default(BORRADOR)
  creadaEn    DateTime            @default(now()) @map("creada_en") @db.Timestamptz(3)

  usuario      Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items        ConfiguracionItem[]
  carritoItems CarritoItem[]

  @@index([usuarioId])
  @@map("configuraciones")
}

model ConfiguracionItem {
  id              String @id @default(uuid(7)) @db.Uuid
  configuracionId String @map("configuracion_id") @db.Uuid
  productoId      String @map("producto_id") @db.Uuid
  /// CHECK cantidad > 0 (migración).
  cantidad        Int    @default(1)

  configuracion Configuracion @relation(fields: [configuracionId], references: [id], onDelete: Cascade)
  producto      Producto      @relation(fields: [productoId], references: [id])

  @@unique([configuracionId, productoId])
  @@map("configuracion_items")
}

model Carrito {
  id            String   @id @default(uuid(7)) @db.Uuid
  usuarioId     String   @unique @map("usuario_id") @db.Uuid
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuario Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items   CarritoItem[]

  @@map("carritos")
}

/// Un ítem apunta a un producto O a una configuración, nunca a ambos ni a ninguno (CHECK en la migración).
model CarritoItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  carritoId       String  @map("carrito_id") @db.Uuid
  productoId      String? @map("producto_id") @db.Uuid
  configuracionId String? @map("configuracion_id") @db.Uuid
  /// CHECK cantidad > 0 (migración).
  cantidad        Int     @default(1)

  carrito       Carrito        @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  producto      Producto?      @relation(fields: [productoId], references: [id])
  configuracion Configuracion? @relation(fields: [configuracionId], references: [id], onDelete: Cascade)

  @@index([carritoId])
  @@map("carrito_items")
}

// ───────────── Reservas, órdenes y comprobantes ─────────────

model Reserva {
  id        String        @id @default(uuid(7)) @db.Uuid
  usuarioId String        @map("usuario_id") @db.Uuid
  estado    EstadoReserva @default(ACTIVA)
  venceEn   DateTime      @map("vence_en") @db.Timestamptz(3)
  creadaEn  DateTime      @default(now()) @map("creada_en") @db.Timestamptz(3)

  usuario Usuario       @relation(fields: [usuarioId], references: [id])
  items   ReservaItem[]
  orden   Orden?

  @@index([estado, venceEn])
  @@index([usuarioId])
  @@map("reservas")
}

model ReservaItem {
  id         String @id @default(uuid(7)) @db.Uuid
  reservaId  String @map("reserva_id") @db.Uuid
  productoId String @map("producto_id") @db.Uuid
  /// CHECK cantidad > 0 (migración).
  cantidad   Int

  reserva  Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([reservaId, productoId])
  @@map("reserva_items")
}

model Orden {
  id                String   @id @default(uuid(7)) @db.Uuid
  usuarioId         String   @map("usuario_id") @db.Uuid
  reservaId         String   @unique @map("reserva_id") @db.Uuid
  /// Un reintento con la misma clave devuelve la orden original.
  claveIdempotencia String   @unique @map("clave_idempotencia")
  /// CHECK total >= 0 (migración).
  total             Decimal  @db.Decimal(12, 2)
  creadaEn          DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)

  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  reserva     Reserva      @relation(fields: [reservaId], references: [id])
  items       OrdenItem[]
  comprobante Comprobante?

  @@index([usuarioId, creadaEn])
  @@map("ordenes")
}

model OrdenItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  ordenId        String  @map("orden_id") @db.Uuid
  productoId     String  @map("producto_id") @db.Uuid
  /// CHECK cantidad > 0 (migración).
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)

  orden    Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("orden_items")
}

model Comprobante {
  id      String   @id @default(uuid(7)) @db.Uuid
  numero  String   @unique
  ordenId String   @unique @map("orden_id") @db.Uuid
  fecha   DateTime @default(now()) @db.Timestamptz(3)
  detalle Json     @db.JsonB

  orden Orden @relation(fields: [ordenId], references: [id])

  @@map("comprobantes")
}

// ───────────── Notificaciones y asistente ─────────────

model Notificacion {
  id        String   @id @default(uuid(7)) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tipo      String
  mensaje   String
  leida     Boolean  @default(false)
  creadaEn  DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leida])
  @@map("notificaciones")
}

/// También sirve de contador del límite de peticiones del asistente (últimas 24 h).
model UsoAsistente {
  id          String   @id @default(uuid(7)) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  presupuesto Decimal  @db.Decimal(12, 2)
  uso         String
  resultado   Json?    @db.JsonB
  latenciaMs  Int      @map("latencia_ms")
  usoRespaldo Boolean  @default(false) @map("uso_respaldo")
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, creadoEn])
  @@map("uso_asistente")
}
