// Configuración del Worker de la API. Versionada y SIN secretos.
// Los valores locales se sobrescriben en .dev.vars (ver .dev.vars.example).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xdtech-api",
  // Wrangler empaqueta la salida de tsc: esbuild no emite emitDecoratorMetadata,
  // que la inyección de dependencias de NestJS necesita (design.md, D2).
  "main": "dist/worker.js",
  "build": {
    "command": "pnpm run build:ts",
    "watch_dir": "src",
  },
  // Dependencias opcionales de NestJS que no se usan (sin WebSockets en Workers).
  "alias": {
    "@nestjs/microservices": "./dist/comun/modulo-vacio.js",
    "@nestjs/microservices/microservices-module.js": "./dist/comun/modulo-vacio.js",
    "@nestjs/websockets/socket-module.js": "./dist/comun/modulo-vacio.js",
  },
  // >= 2026-08-04: nodejs_compat viene activado sin flag.
  "compatibility_date": "2026-11-01",
  // Custom Domain de la API (tarea 6.5). La cookie de sesión usa Domain=.xdtech.store.
  "workers_dev": true,
  "routes": [{ "pattern": "api.xdtech.store", "custom_domain": true }],
  // Smart Placement (tarea 10.4 del Sprint 1.5): cada petición hace varias consultas a Neon por
  // Hyperdrive; ejecutar el Worker cerca de la base reduce la latencia de cada viaje. No cambia
  // la consistencia (el stock sigue sin caché). Los Durable Objects no se ven afectados.
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
  },
  // Deben coincidir con HORARIOS en src/programadas/despacho.ts (lo verifica una prueba).
  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *", "0 4 * * *"],
  },
  // Valores de producción. En local, .dev.vars los sobrescribe.
  "vars": {
    "COOKIE_DOMAIN": ".xdtech.store",
    "FRONTEND_ORIGIN": "https://xdtech.store",
    "SESSION_TTL_DAYS": "7",
    "HEALTH_TIMEOUT_MS": "3000",
    // Vencimiento de las reservas en minutos (spec reservas; admite decimales en pruebas).
    "RESERVA_TTL_MIN": "10",
    // Pago simulado (spec pagos): APROBAR o RECHAZAR fuerzan el resultado en pruebas; vacío,
    // decide la tarjeta de prueba.
    "PAGO_SIMULADO_FORZAR": "",
    // Asistente de IA (spec asistente, Sprint 5). IA_HABILITADA distinto de "true" apaga la
    // IA: todo sale del respaldo determinístico. Las llamadas van por AI Gateway; su URL y su
    // token son secretos (IA_GATEWAY_URL, CF_AIG_TOKEN), nunca vars.
    "IA_HABILITADA": "true",
    "IA_PROVEEDOR": "anthropic",
    "IA_MODELO": "claude-opus-5-5",
    "IA_TIMEOUT_MS": "20000",
    "ASISTENTE_LIMITE_24H": "10",
    // Límites de peticiones (spec limite-peticiones; sección 7 de la parte técnica).
    "LIMITE_REGISTRO_MAX": "5",
    "LIMITE_REGISTRO_VENTANA_MIN": "60",
    "LIMITE_LOGIN_CORREO_MAX": "5",
    "LIMITE_LOGIN_IP_MAX": "50",
    "LIMITE_LOGIN_VENTANA_MIN": "15",
  },
  "durable_objects": {
    "bindings": [
      { "name": "INVENTARIO", "class_name": "Inventario" },
      { "name": "LIMITES", "class_name": "Limites" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inventario", "Limites"] }],
  // Imágenes de producto (design D9 del Sprint 1.5). En local (wrangler dev, pruebas) R2 se
  // simula; el bucket de producción se creó con `wrangler r2 bucket create xdtech-imagenes`.
  "r2_buckets": [{ "binding": "IMAGENES", "bucket_name": "xdtech-imagenes" }],
  // Neon a través de Hyperdrive, con caché de consultas DESACTIVADO (design.md D4).
  // La cadena de Neon vive en la configuración de Hyperdrive, no en el repositorio.
  // En local (`wrangler dev` y pruebas) se usa el Postgres de docker-compose.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0ff5d663f391438e910b4e16b44f14e5",
      "localConnectionString": "postgresql://xdtech:xdtech@localhost:5432/xdtech",
    },
  ],
}
