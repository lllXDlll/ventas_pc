{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "build:ts": "tsc -p tsconfig.build.json && node scripts/copiar-recursos.mjs",
    "build": "wrangler deploy --dry-run --outdir .wrangler/dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --no-strict-vars",
    "typecheck": "tsc -p tsconfig.json",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "test": "vitest run --project unit --project workers",
    "test:int": "vitest run --project integracion"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "jsonc-parser": "^3.3.1",
    "prisma": "7.10.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
