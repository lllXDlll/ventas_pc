{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "types": ["node", "@cloudflare/vitest-plugin/types"],
    "noEmit": true,
    // scripts/ se ejecuta con Node 24 (TypeScript directo), que exige la extensión .ts.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "scripts", "worker-configuration.d.ts", "vitest.config.ts"]
}
